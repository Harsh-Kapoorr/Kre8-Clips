# Kre8 Clips Configuration
# Copy this to .env and fill in your API keys

# JWT Secret for signing auth tokens (generate with: openssl rand -base64 32)
# REQUIRED - generate a new one for production
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Google OAuth (for sign-in with Google)
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# DeepGram API Key (for transcription)
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Gemini API Key (for AI analysis)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (for sign-in with Google)
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Enable speaker-aware vertical smart cropping by default
ENABLE_SPEAKER_TRACKING=true

# Export JSON tracking debug snapshots to output/
ENABLE_TRACKING_DEBUG=true

# === Cost Optimization ===
# Cheaper Gemini model (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Cap Gemini output tokens (default: 4096)
# GEMINI_MAX_OUTPUT_TOKENS=4096

# Cap Gemini input transcript size in chars (default: 60000)
# GEMINI_INPUT_CHAR_CAP=60000

# Set to 1 to skip Gemini entirely and return a synthetic clip (test mode)
# MOCK_GEMINI_RESPONSE=0

# Set to 1 to disable the API response cache (default: 0)
# CLIPGEN_DISABLE_CACHE=0

# === Clip Fade In/Out (softens abrupt start/end of every generated clip) ===
# Apply a video + audio fade-in at the start and fade-out at the end of each clip
ENABLE_CLIP_FADES=true
# Fade-in duration in seconds (default: 0.3)
CLIP_FADE_IN_DURATION=0.3
# Fade-out duration in seconds (default: 0.5)
CLIP_FADE_OUT_DURATION=0.5
# Easing curve. Empty = linear. "qua" = quadratic ease-out for a cinematic
# settle-into-black on the fade-out. Valid options: tri, qua, cub, squ, cbr,
# par, exp, lin, sin, cos, log, ipar. Invalid values fall back to linear.
CLIP_FADE_IN_CURVE=
CLIP_FADE_OUT_CURVE=qua
